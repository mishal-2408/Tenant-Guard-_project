# ==============================================================================
# TenantGuard Server - Environment Variables Template (.env.example)
# Copy this file to server/.env and provide your actual values.
# NEVER commit real credentials to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# Replace with your local MongoDB URI or MongoDB Atlas connection string:
# Local example: mongodb://127.0.0.1:27017/tenantguard
# Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/tenantguard?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string

# Authentication & JWT Configuration
# Use a cryptographically secure random string (minimum 32 characters)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_here_change_in_production
JWT_ACCESS_EXPIRATION=15m

# Cookie Security Configuration
# Set COOKIE_SECURE=true when deploying over HTTPS in production
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
