# ==============================================================================
# TenantGuard Server - Environment Variables Reference (.env.example)
# Location: server/.env
# ==============================================================================

PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tenantguard?retryWrites=true&w=majority

JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_here_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_here_change_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

COOKIE_SECRET=your_cookie_signing_secret_here_change_in_production
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15
