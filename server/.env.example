# ==============================================================================
# TenantGuard Server - Environment Variables Template (.env.example)
# Copy this file to server/.env and provide your actual values.
# NEVER commit real credentials to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# Replace with your local MongoDB URI or MongoDB Atlas connection string:
# Local example: mongodb://localhost:27017/tenantguard
# Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/tenantguard?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string
