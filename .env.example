# ==============================================================================
# TenantGuard Platform - Environment Variables Reference (.env.example)
# Note: Copy this file to .env in production or local development and update values.
# NEVER commit real .env files to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas / Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tenantguard?retryWrites=true&w=majority

# JWT Authentication Secrets (Use cryptographically random 256-bit+ strings)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_here_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_here_change_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Cookie Configuration
COOKIE_SECRET=your_cookie_signing_secret_here_change_in_production
COOKIE_SECURE=false # Set to true in production (HTTPS)
COOKIE_SAME_SITE=lax # lax or strict

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Security / Account Lockout
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15

# Platform Super Admin Initial Setup (Optional initial seed)
INITIAL_SUPERADMIN_EMAIL=superadmin@tenantguard.local
INITIAL_SUPERADMIN_PASSWORD=ChangeMeImmediately123!
